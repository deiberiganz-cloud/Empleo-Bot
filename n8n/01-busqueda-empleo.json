    {
      "parameters": {
        "jsCode": "// Una búsqueda por item: el nodo siguiente se ejecuta una vez por cada una.\nconst busquedas = ['desarrollador', 'react', 'node', 'soporte', 'atención al cliente', 'ecommerce', 'qa', 'automatización'];\nreturn busquedas.map(q => ({ json: { q } }));"
      },
      "name": "Búsquedas Get on Board",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        800
      ]
    },
    {
      "parameters": {
        "url": "=https://www.getonbrd.com/api/v0/search/jobs?query={{ encodeURIComponent($json.q) }}&per_page=50&remote=true&expand=%5B%22company%22%5D",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (empleo-bot personal)"
            }
          ]
        },
        "options": {}
      },
      "name": "Get on Board",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        800
      ]
    },
    {
      "parameters": {
        "numberInputs": 6
      },
      "name": "Juntar portales",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        760,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Convierte la respuesta de cada portal al mismo formato y aplica el prefiltro (0 tokens).\nconst limpiar = h => String(h || '').replace(/<[^>]+>/g, ' ').replace(/&[a-z#0-9]+;/gi, ' ').replace(/\\s+/g, ' ').trim();\nconst SENIOR = /\\b(senior|sr\\.?|semi ?senior|ssr|lead|staff|principal|manager|director|head of|architect|arquitect[oa]|jefe|gerente)\\b/i;\nconst INGLES = /(fluent|advanced|excellent|native|proficient|strong|professional|business|c1|c2|b2)[^.]{0,25}english|english[^.]{0,20}(fluen|advanced|c1|c2|b2|required|proficien)|ingl[eé]s[^.]{0,15}(avanzado|fluido|intermedio|conversacional|c1|c2|b2|excluyente)|\\(ingl[eé]s\\)/i;\nconst HISPANO = /spanish|español|espanol|latam|latin america|latinoam[eé]rica|argentina|south america|sudam[eé]rica|hispan/i;\n\nconst ofertas = [];\nfor (const { json: j } of $input.all()) {\n  if (j.legal) continue;\n  if (Array.isArray(j.jobs) && j['job-count'] !== undefined) {\n    for (const x of j.jobs) ofertas.push({ fuente: 'Remotive', titulo: x.title, empresa: x.company_name, url: x.url,\n      ubicacion: x.candidate_required_location, descripcion: limpiar(x.description), fecha: String(x.publication_date).slice(0, 10) });\n  } else if (Array.isArray(j.jobs)) {\n    for (const x of j.jobs) ofertas.push({ fuente: 'Himalayas', titulo: x.title, empresa: x.companyName, url: x.applicationLink || x.guid,\n      ubicacion: (x.locationRestrictions || []).join(', ') || 'Worldwide', descripcion: limpiar(`${x.excerpt} ${x.description}`), fecha: String(x.pubDate).slice(0, 10) });\n  } else if (Array.isArray(j.data)) {\n    for (const x of j.data) {\n      const a = x.attributes;\n      ofertas.push({ fuente: 'Get on Board', titulo: a.title, empresa: a.company?.data?.attributes?.name || '', url: x.links?.public_url,\n        ubicacion: `${a.remote_modality} ${(a.countries || []).join(', ')}`, descripcion: limpiar([a.description, a.functions, a.desirable].join(' ')),\n        fecha: new Date(a.published_at * 1000).toISOString().slice(0, 10) });\n    }\n  } else if (j.position) {\n    ofertas.push({ fuente: 'RemoteOK', titulo: j.position, empresa: j.company, url: j.url, ubicacion: j.location || 'Worldwide',\n      descripcion: limpiar(j.description), fecha: String(j.date).slice(0, 10) });\n  } else if (j.company_name && j.pub_date !== undefined) {\n    ofertas.push({ fuente: 'Working Nomads', titulo: j.title, empresa: j.company_name, url: j.url, ubicacion: j.location || 'Worldwide',\n      descripcion: limpiar(j.description), fecha: String(j.pub_date).slice(0, 10) });\n  } else if (j.link) {\n    const partes = String(j.title).split(': ');\n    ofertas.push({ fuente: 'We Work Remotely', titulo: partes.length > 1 ? partes.slice(1).join(': ') : j.title, empresa: partes.length > 1 ? partes[0] : '',\n      url: j.link, ubicacion: '', descripcion: limpiar(j.content || j.contentSnippet), fecha: String(j.isoDate).slice(0, 10) });\n  }\n}\n\nconst vistas = new Set();\nconst pasan = ofertas.filter(o => {\n  if (!o.url || vistas.has(o.url)) return false;\n  vistas.add(o.url);\n  const texto = `${o.titulo} ${o.ubicacion} ${o.descripcion}`;\n  if (SENIOR.test(o.titulo) || INGLES.test(texto)) return false;\n  return o.fuente === 'Get on Board' || HISPANO.test(texto);\n});\nreturn pasan.map(o => ({ json: o }));\n"
      },
